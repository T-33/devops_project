# ==========================================
# Terraform
# ==========================================
# Local .terraform directories (provider binaries)
**/.terraform/*

# State files (CONTAINS SECRETS - NEVER COMMIT)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
# Allow example variable files
!example.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
